{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-prompt-library/schema/library.schema.json",
  "title": "geo-prompt-library output",
  "type": "object",
  "required": [
    "schema_version", "library_id", "library_version", "frozen", "content_hash",
    "generated_at", "generator", "company", "competitors", "personas",
    "locale", "distribution", "matrix_plan", "intents"
  ],
  "additionalProperties": false,
  "if": {
    "properties": { "schema_version": { "pattern": "^1\\.0\\.\\d+$" } },
    "required": ["schema_version"]
  },
  "then": {},
  "else": { "required": ["inputs"] },
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "library_id": { "type": "string", "minLength": 1 },
    "library_version": { "type": "integer", "minimum": 1 },
    "frozen": { "type": "boolean" },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "inputs": {
      "description": "Provenance: the normalized request this library was actually built from (Faza 1-3). REQUIRED for schema_version 1.1.0+ (see the root-level if/then below) -- not a top-level `required` entry, because that would apply unconditionally to schema_version 1.0.x too, where inputs never existed and the 23 gate fixtures deliberately don't have it. A library that claims 1.1.0+ but omits inputs now fails G1 loudly (schema violation), instead of the field silently reading as absent/None at runtime -- three distinguishable states (1.0.x: exempt by version / 1.1.0+ with inputs: known geo_scope, possibly explicit null / 1.1.0+ without inputs: G1 fails), not two.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "locale", "vertical", "n_intents", "geo_scope", "competitors_source"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "locale": { "enum": ["sr-RS", "sr-ME", "hr-HR", "bs-BA", "en-US", "en-GB"] },
        "vertical": { "type": ["string", "null"], "description": "As given by the user; null if left to be derived from the site." },
        "n_intents": { "type": "integer", "minimum": 1 },
        "geo_scope": {
          "type": ["string", "null"],
          "enum": ["national", "city", "multi_city", "global", null],
          "description": "The requested scope, if the user gave one explicitly; null if left to be derived. This is the source G4/build_warnings read for the geo_scope==global exception -- NOT intents[0].geo.scope, which is per-intent and legitimately varies within a multi_city library."
        },
        "competitors_source": { "enum": ["user_provided", "researched"] }
      }
    },
    "generator": {
      "type": "object",
      "required": ["skill", "skill_version"],
      "additionalProperties": false,
      "properties": {
        "skill": { "type": "string" },
        "skill_version": { "type": "string" }
      }
    },
    "company": {
      "type": "object",
      "required": ["name", "aliases", "url", "vertical", "offerings", "locations", "site_language", "confidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "format": "uri" },
        "vertical": { "type": "string", "minLength": 1 },
        "offerings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "source_url", "evidence"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "source_url": { "type": "string", "format": "uri" },
              "evidence": { "type": "string" }
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["city", "country", "source_url"],
            "additionalProperties": false,
            "properties": {
              "city": { "type": "string" },
              "country": { "type": "string" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        },
        "site_language": { "type": "string" },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "how_found", "confidence"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "how_found": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "city": { "type": "string" }
        }
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "derived_from"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "derived_from": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "locale": {
      "type": "object",
      "required": ["primary", "script_default", "paired_language"],
      "additionalProperties": false,
      "properties": {
        "primary": { "enum": ["sr-RS", "sr-ME", "hr-HR", "bs-BA", "en-US", "en-GB"] },
        "script_default": { "enum": ["latin", "cyrillic"] },
        "paired_language": { "type": "string" }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["target", "actual", "n_intents", "n_queries"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": {
            "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
          }
        },
        "actual": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "n_intents": { "type": "integer", "minimum": 1 },
        "n_queries": { "type": "integer", "minimum": 1 }
      }
    },
    "matrix_plan": {
      "description": "Faza-3 plan pre pisanja teksta: koliko intenata je predviđeno po celiji kategorija x persona x grad. G16 poredi ovo sa stvarnim brojem intenata po celiji -- revizorski trag pokrivenosti.",
      "type": "object",
      "required": ["planned_total", "cells"],
      "additionalProperties": false,
      "properties": {
        "planned_total": { "type": "integer", "minimum": 1 },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "persona_id", "geo_city", "planned"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "problem_aware", "category_shortlist", "use_case", "comparison",
                  "pricing", "local", "trust_risk", "branded"
                ]
              },
              "persona_id": { "type": ["string", "null"] },
              "geo_city": { "type": ["string", "null"] },
              "planned": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/intent" }
    },
    "validation": {
      "type": "object",
      "required": ["passed", "gate_version", "checks", "warnings"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "boolean" },
        "gate_version": { "type": "string" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "passed", "detail", "derived"],
            "additionalProperties": false,
            "properties": {
              "rule": { "type": "string" },
              "passed": { "type": "boolean" },
              "detail": { "type": "string" },
              "derived": {
                "type": "boolean",
                "description": "True if this rule only failed as a downstream echo of another rule's failure in the same run (see DERIVED_FROM in validate_library.py) -- exclude from Faza 6 retry-cell targeting."
              }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes_for_downstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freeze_policy": { "type": "string" },
        "reporting": { "type": "string" },
        "recommended_runs": { "type": "string" }
      }
    }
  },
  "$defs": {
    "intent": {
      "type": "object",
      "required": [
        "intent_id", "category", "awareness_stage", "intent_type", "micro_moment",
        "buying_stage", "persona_id", "priority", "branded", "brand_mentioned",
        "competitors_mentioned", "geo", "expected_answer_type", "rationale",
        "grounding", "inferred", "queries"
      ],
      "additionalProperties": false,
      "properties": {
        "intent_id": { "type": "string", "pattern": "^int-\\d{3,}$" },
        "category": {
          "enum": [
            "problem_aware", "category_shortlist", "use_case", "comparison",
            "pricing", "local", "trust_risk", "branded"
          ]
        },
        "awareness_stage": {
          "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware"]
        },
        "intent_type": {
          "enum": ["informational", "navigational", "commercial_investigation", "transactional"]
        },
        "micro_moment": {
          "enum": ["i_want_to_know", "i_want_to_go", "i_want_to_do", "i_want_to_buy"]
        },
        "buying_stage": { "type": "string" },
        "persona_id": { "type": ["string", "null"] },
        "priority": { "enum": ["tier1", "tier2"] },
        "branded": { "type": "boolean" },
        "brand_mentioned": { "type": ["string", "null"] },
        "competitors_mentioned": { "type": "array", "items": { "type": "string" } },
        "geo": {
          "type": "object",
          "required": ["country", "city", "scope"],
          "additionalProperties": false,
          "properties": {
            "country": { "type": ["string", "null"] },
            "city": { "type": ["string", "null"] },
            "scope": { "enum": ["national", "city", "multi_city", "global"] }
          }
        },
        "expected_answer_type": {
          "enum": ["list", "single_recommendation", "explanation", "comparison_table", "fact"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "grounding": {
          "type": "object",
          "required": ["type", "url", "quote"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] },
            "quote": { "type": ["string", "null"] }
          }
        },
        "inferred": { "type": "boolean" },
        "queries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/query" }
        }
      }
    },
    "query": {
      "type": "object",
      "required": [
        "query_id", "lang", "text", "script", "orthography", "word_count", "variants"
      ],
      "additionalProperties": false,
      "properties": {
        "query_id": { "type": "string", "minLength": 1 },
        "lang": { "type": "string", "minLength": 2, "maxLength": 2 },
        "text": { "type": "string", "minLength": 1 },
        "script": { "enum": ["latin", "cyrillic"] },
        "orthography": { "type": "string" },
        "word_count": { "type": "integer", "minimum": 1 },
        "variants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ascii": { "type": "string" },
            "cyrillic": { "type": "string" }
          }
        }
      }
    }
  }
}
